CREATE TABLE projects (
    id_project BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name_pr VARCHAR(100) NOT NULL,
    description_pr VARCHAR(255) UNIQUE NOT NULL,
    owner_id integer NOT NULL,
    base_url VARCHAR(100) NOT NULL,
    created_at_p TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
   CONSTRAINT fk_projects_owner
        FOREIGN KEY (owner_id)
        REFERENCES public.users(id)
        ON DELETE RESTRICT,

    CONSTRAINT chk_projects_base_url
        CHECK (base_url ~ '^https?://')
);

-------------------------------------------------------

CREATE OR REPLACE PROCEDURE sp_create_project
(
    IN p_name VARCHAR(150),
    IN p_description TEXT,
    IN p_owner_id BIGINT,
    IN p_base_url VARCHAR(500),
    INOUT p_project_id BIGINT
)
LANGUAGE plpgsql
AS $$
BEGIN

    INSERT INTO projects
    (
        name,
        description,
        owner_id,
        base_url
    )
    VALUES
    (
        p_name,
        p_description,
        p_owner_id,
        p_base_url
    )
    RETURNING id INTO p_project_id;

END;
$$;


-------------------------------------------------------------------------

CREATE OR REPLACE PROCEDURE sp_update_project
(
    IN p_id BIGINT,
    IN p_name VARCHAR(150),
    IN p_description TEXT,
    IN p_owner_id BIGINT,
    IN p_base_url VARCHAR(500)
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_rows INTEGER;
BEGIN

    UPDATE projects
    SET
        name = p_name,
        description = p_description,
        owner_id = p_owner_id,
        base_url = p_base_url
    WHERE id = p_id;

    GET DIAGNOSTICS v_rows = ROW_COUNT;

    IF v_rows = 0 THEN
        RAISE EXCEPTION 'Projet avec ID % introuvable', p_id;
    END IF;

END;
$$;

---------------------------------------------------------------------------------------------------


CREATE OR REPLACE PROCEDURE sp_delete_project
(
    IN p_id BIGINT
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_rows INTEGER;
BEGIN

    DELETE FROM projects
    WHERE id = p_id;

    GET DIAGNOSTICS v_rows = ROW_COUNT;

    IF v_rows = 0 THEN
        RAISE EXCEPTION 'Projet avec ID % introuvable', p_id;
    END IF;

END;
$$;



